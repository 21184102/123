{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A user's private todo task item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique task identifier"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "The UID of the user who owns the task"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "The title or content of the task"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed notes or description"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is marked as done"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Priority level"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category or tag name"
        },
        "dueDate": {
          "type": "string",
          "maxLength": 50,
          "description": "Due date ISO string (YYYY-MM-DD) or empty"
        },
        "dueTime": {
          "type": "string",
          "maxLength": 20,
          "description": "Due time string (HH:mm) or empty"
        },
        "reminderMinutes": {
          "type": "number",
          "description": "Minutes before due for reminder"
        },
        "googleEventId": {
          "type": "string",
          "maxLength": 256,
          "description": "ID of synchronized Google Calendar event"
        },
        "googleEventLink": {
          "type": "string",
          "maxLength": 1024,
          "description": "HTML link to the Google Calendar event"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "title", "completed", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User private profile metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "User ID"
        },
        "email": {
          "type": "string",
          "maxLength": 256,
          "description": "Google email"
        },
        "displayName": {
          "type": "string",
          "maxLength": 128,
          "description": "Display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024,
          "description": "User avatar URL"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last login update timestamp"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User private tasks subcollection. Ensures strict privacy: only the authenticated user matching userId can list, get, create, update, or delete their tasks."
    },
    "/users/{userId}/profile/info": {
      "schema": "UserProfile",
      "description": "User private profile document. Strictly isolated to the owner."
    }
  }
}
